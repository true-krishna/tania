# Base URL of the external Talent Profile API (used by server-rendered pages).
# Set to wherever the backend is served, e.g. http://localhost:8080
TANIA_API_URL=http://localhost:8080

# Same API, but exposed to the browser for the client-side "Add User" form.
# The backend must allow requests from this frontend (CORS).
NEXT_PUBLIC_TANIA_API_URL=http://localhost:8080
