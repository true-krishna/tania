# --- Talent Profile API (REST, fitur lama — dipensiunkan bertahap, plan.md R2) ---
# Base URL of the external Talent Profile API (used by server-rendered pages).
# Set to wherever the backend is served, e.g. http://localhost:8080
# NOTE: this is the LEGACY REST slice (`src/lib/api.ts`), which targets an API that
# `codex/backend/tania-backend` does not serve. It is retired in F9 (task T127).
TANIA_API_URL=http://localhost:8080

# Same API, exposed to the browser for the client-side "Add User" form.
NEXT_PUBLIC_TANIA_API_URL=http://localhost:8080

# GraphQL endpoint of codex/backend/tania-backend, consumed by Apollo Client.
# Added with the Apollo data layer (plan.md §Data Layer, task T008); unused until then.
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:8080/graphql
