# --- Talent Profile API (REST, fitur lama — dipensiunkan bertahap, plan.md R2) ---
# Base URL of the external Talent Profile API (used by server-rendered pages).
TANIA_API_URL=http://localhost:8080

# Same API, exposed to the browser for the client-side "Add User" form.
NEXT_PUBLIC_TANIA_API_URL=http://localhost:8080

# --- GraphQL API (data layer utama, Apollo Client — plan.md §3.2 / §6.2) ---
# Endpoint GraphQL backend; dipakai oleh Apollo Client di browser.
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:8080/query

# --- Auth (plan.md R3) ---
# Mode dev: anggap sudah login tanpa backend auth. Set 1 untuk pengembangan
# frontend murni; hapus/tidak diset untuk mode normal (guard aktif, login lokal).
NEXT_PUBLIC_AUTH_LOCAL_ONLY=0

# Dipakai hanya saat NEXT_PUBLIC_AUTH_LOCAL_ONLY=1: peran default sesi dev.
# Nilai salah satu: ADMIN | OPERATION | CHAPTER | TALENT
NEXT_PUBLIC_DEFAULT_ACCESS_ROLE=TALENT