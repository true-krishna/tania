# GraphQL endpoint of codex/backend/tania-backend, consumed by Apollo Client
# (plan.md §Data Layer, task T008). The legacy Talent Profile REST client and
# its TANIA_API_URL / NEXT_PUBLIC_TANIA_API_URL vars were retired (tasks T127/T142).
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:8080/graphql

# Auth guard — dev mode (see src/lib/auth/config.ts, plan.md R3).
# `1` = treat the user as logged in with DEFAULT_ACCESS_ROLE (skip login);
# unset / `0` = normal mode (guard active, real login).
NEXT_PUBLIC_AUTH_LOCAL_ONLY=0

# Role applied when AUTH_LOCAL_ONLY=1 (unused otherwise).
NEXT_PUBLIC_DEFAULT_ACCESS_ROLE=TALENT
